cabal-version: 3.0
name:          TypeClasses
version:       0.1.0.0
maintainer:    daniel.kroeni@fhnw.ch
author:        Daniel Kröni
build-type:    Simple

library
    exposed-modules:
        TypeClasses.Person
        TypeClasses.Nat
        MapReduce.WordCount
        Map.TreeMap
        Lang.Imp
    build-depends:
        base >=4.17 && <5,
        directory
    default-language: Haskell2010
    ghc-options:      -Wall

test-suite map
    type:             exitcode-stdio-1.0
    hs-source-dirs:   Map
    main-is:          Tests.hs
    default-language: Haskell2010
    ghc-options:      -Wall
    build-depends:
        base >=4.17 && <5,
        TypeClasses,
        hspec ==2.11.17,
        hspec-contrib,
        QuickCheck,
        HUnit

test-suite imp
    type:             exitcode-stdio-1.0
    hs-source-dirs:   Lang
    main-is:          Tests.hs
    default-language: Haskell2010
    ghc-options:      -Wall
    build-depends:
        base >=4.17 && <5,
        TypeClasses,
        hspec ==2.11.17,
        hspec-contrib,
        QuickCheck,
        HUnit